# Copiar a .env. Nunca subir .env a git.
# Si la password tiene $, en este archivo va como $$.

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Token interno BFF ↔ mq-admin (header X-Internal-Token).
INTERNAL_TOKEN=cambiar-esto

# Kafka para audit.timeline (EP3-27). En local: localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
